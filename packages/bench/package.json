{
	"name": "@effect-bench/bench",
	"private": true,
	"description": "The workloads and the harness: each workload runs real code on an input built in memory, and the harness times it and prints the digest every engine must agree on.",
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#*": "./src/*"
	},
	"scripts": {
		"typecheck": "effect-tsgo tsrs",
		"superlint": "superlint",
		"oxlint": "oxlint",
		"bundle": "node scripts/bundle.ts"
	},
	"dependencies": {
		"@aidenzepp/effect-xml": "catalog:",
		"@effect-bench/json": "workspace:*",
		"@effect-bench/testing": "workspace:*",
		"@harvest/grizzle-engine": "workspace:*",
		"@harvest/openapi-cli-generator": "workspace:*",
		"@qti-pie/plate": "catalog:",
		"effect": "catalog:"
	},
	"devDependencies": {
		"@effect-bench/devtools": "workspace:*",
		"@effect/platform-node": "catalog:",
		"@types/node": "catalog:",
		"esbuild": "catalog:",
		"typescript": "catalog:"
	}
}
