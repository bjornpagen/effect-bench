{
	"name": "@effect-bench/devtools",
	"private": true,
	"description": "effect-bench's dev tools: the lint preset, the tsconfig base and its Effect-free variant, the oxlint plugin and superlint (type-aware rules on TypeScript 7's native API), each proven against fixtures.",
	"type": "module",
	"imports": {
		"#*": "./src/*"
	},
	"exports": {
		"./preset": "./src/preset.ts",
		"./tsconfig.base.json": "./tsconfig.base.json",
		"./tsconfig.effect-free.json": "./tsconfig.effect-free.json"
	},
	"bin": {
		"superlint": "./src/lint.ts"
	},
	"scripts": {
		"typecheck": "effect-tsgo tsrs",
		"superlint": "node src/lint.ts",
		"oxlint": "oxlint",
		"fixtures:superlint": "node src/lint.ts --fixtures",
		"fixtures:oxlint": "node src/oxlint/fixtures.ts"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:",
		"@effect-bench/json": "workspace:*",
		"effect": "catalog:",
		"oxlint": "catalog:",
		"typescript": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:"
	}
}
