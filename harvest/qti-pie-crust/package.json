		"./tree.ts": "./src/tree.ts",
		"./uri.ts": "./src/uri.ts",
		"./write.ts": "./src/write.ts"
	},
	"scripts": {
		"typecheck": "effect-tsgo tsrs"
	},
	"dependencies": {
		"effect": "catalog:",
		"saxes": "catalog:"
	},
	"devDependencies": {
		"typescript": "catalog:"
	}
}
